<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 Auto Backup rules — same exclusions as
     data_extraction_rules.xml, needed since wear's minSdk (30) is below
     API 31. -->
<full-backup-content>
    <exclude domain="database" path="pipboy.db" />
    <exclude domain="database" path="pipboy.db-wal" />
    <exclude domain="database" path="pipboy.db-shm" />
    <exclude domain="sharedpref" path="pipboy_db_key.xml" />
</full-backup-content>
